{
  "hosting": {
    "public": "frontend/pwa",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "backend/dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "backend/dataconnect"
  }
}

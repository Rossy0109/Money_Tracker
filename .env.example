# ==============================================================================
# Money Tracker (আমার হিসাব) Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION MODE CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'google' for independent Vercel staging/production deployment.
# Set to 'manus' for internal development environment.
AUTH_MODE=google
VITE_AUTH_MODE=google

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH CONFIGURATION (Required when AUTH_MODE=google)
# ------------------------------------------------------------------------------
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Staging/Preview Callback URL:
# https://<your-project>-git-staging-<team>.vercel.app/api/auth/google/callback
# Production Callback URL:
# https://<your-domain>.vercel.app/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.vercel.app/api/auth/google/callback

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Standard MySQL / TiDB Cloud Serverless Connection URL with TLS
# Example: mysql://<user>:<password>@gateway01.<region>.tidbcloud.com:4000/<dbname>?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql://root:password@127.0.0.1:3306/money_tracker

# ------------------------------------------------------------------------------
# 4. SESSION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Random string (minimum 32 characters) for encrypting session cookies
SESSION_SECRET=generate-a-secure-random-32-character-session-secret
# Random string for JWT verification
JWT_SECRET=generate-a-secure-random-32-character-jwt-secret

# Administrator Bootstrap & 2FA Password
ADMIN_BOOTSTRAP_EMAIL=kamrul01@gmail.com
ADMIN_ACCESS_PASSWORD=your-secure-admin-second-factor-password

# ------------------------------------------------------------------------------
# 5. STORAGE CONFIGURATION (Vercel Blob)
# ------------------------------------------------------------------------------
# Automatically injected by Vercel when linking a Blob store in the Vercel project settings
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# 6. NODE & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# .env.example - Money_Tracker
# Copy this to .env for local development or set each value in your deployment platform (Vercel for frontend, Render for backend).
# Markers: public (exposed to browser) use NEXT_PUBLIC_ prefix. Secrets must only be set on the server (Render) and never pushed to client envs.

##############################
# Supabase (Postgres + Auth)
##############################
# Client (frontend - safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://ulmaomfsyjbwcwecutcp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_q1xXSPOatO5A4TqibiPfBA_KdK9q2NA
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_q1xXSPOatO5A4TqibiPfBA_KdK9q2NA # Fallback

# Server (backend - secret, high privileges)
SUPABASE_SERVICE_ROLE_KEY=
# Database connection string for server-side direct Postgres access (optional)
DATABASE_URL=
# or: SUPABASE_DB_URL= or POSTGRES_URL=

##############################
# Firebase (Auth, Storage)
##############################
# Client (frontend - safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID= # optional

# Admin (server-side secret)
# Store the full service account JSON as a single-line base64 string to avoid multiline env problems.
# Example to create the value locally:
#   cat service-account.json | base64 | tr -d '\n'  -> paste into FIREBASE_ADMIN_CREDENTIALS
FIREBASE_ADMIN_CREDENTIALS=
FIREBASE_DATABASE_URL= # optional (Realtime DB URL), e.g. https://<project>.firebaseio.com

##############################
# App / Deployment (server-side)
##############################
NODE_ENV=production
PORT=3000
# JWT/session secrets (server-only)
JWT_SECRET=
SESSION_COOKIE_SECRET=
COOKIE_DOMAIN= # e.g. .yourdomain.com (optional)

##############################
# Storage / Buckets / Names
##############################
# If you use a specific Supabase/Firebase bucket name besides the default
SUPABASE_STORAGE_BUCKET=
FIREBASE_STORAGE_BUCKET=

##############################
# Optional Integrations / Monitoring
##############################
SENTRY_DSN=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

##############################
# Notes / Usage
##############################
# - Put NEXT_PUBLIC_* vars in Vercel (frontend) so the Next.js app can access them client-side.
# - Put SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, FIREBASE_ADMIN_CREDENTIALS, JWT_SECRET, SESSION_COOKIE_SECRET, and other secrets in Render (backend) ONLY.
# - To decode FIREBASE_ADMIN_CREDENTIALS on the server at startup:
#     echo "$FIREBASE_ADMIN_CREDENTIALS" | base64 --decode > ./firebase-service-account.json
# - Rotate service_role keys and service account credentials if they are ever exposed.
# - Keep this file in source control as .env.example but never commit real secrets.

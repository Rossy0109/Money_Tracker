# ==============================================================================
# Money Tracker (আমার হিসাব) Environment Configuration Template
# ==============================================================================

# Environment layering (mirrors Vite's behavior):
#   LOCAL dev:  .env  →  .env.local  →  .env.development  →  .env.development.local  (later wins)
#   LOCAL prod: .env  →  .env.local  →  .env.production    →  .env.production.local   (later wins)
#   VERCEL:     all values injected via Vercel dashboard; .env is NOT loaded.
#
# The check-auth-mode script verifies AUTH_MODE === VITE_AUTH_MODE after loading
# the correct layer set. It runs automatically before dev/build.

# ------------------------------------------------------------------------------
# 1. RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION MODE CONFIGURATION
# ------------------------------------------------------------------------------
# 'google' for standalone/Vercel deployment with Google OAuth
# 'password' for standalone username/password auth mode
#
# CRITICAL: AUTH_MODE (server) and VITE_AUTH_MODE (client) MUST always match.
# The build/dev scripts enforce this automatically.
AUTH_MODE=google
VITE_AUTH_MODE=google

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 CREDENTIALS (Required when AUTH_MODE=google)
# ------------------------------------------------------------------------------
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web)
#
# For LOCAL dev:  use a client registered with http://localhost:3000/api/auth/google/callback
# For PRODUCTION: use a client registered with https://your-domain.vercel.app/api/auth/google/callback
#
# These can be (and usually are) DIFFERENT Google Cloud OAuth clients.
# GOOGLE_OAUTH_REDIRECT_URI must match an Authorized Redirect URI in the console EXACTLY.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 3.1 GITHUB OAUTH CREDENTIALS (Optional for GitHub 1-Click Login)
# ------------------------------------------------------------------------------
# Create in GitHub -> Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# Homepage URL: http://localhost:3000 (or https://your-domain.vercel.app)
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
# (or https://your-domain.vercel.app/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. DATABASE CONNECTION
# ------------------------------------------------------------------------------
# LOCAL: use a local MySQL/MariaDB instance — NEVER point at the production database.
# PRODUCTION: injected by Vercel; this file is not loaded there.
#
# Example (local): mysql://root:password@127.0.0.1:3306/money_tracker
DATABASE_URL=
ISOLATED_E2E_DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. SESSION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Random 32+ character strings for encrypting session cookies and JWTs.
# Generate with: head -c 64 /dev/urandom | base64 | tr -d '/+=' | head -c 64
SESSION_SECRET=generate-a-secure-random-32-character-session-secret
JWT_SECRET=generate-a-secure-random-32-character-jwt-secret

# Administrator Bootstrap & 2FA Password
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_ACCESS_PASSWORD=your-secure-admin-second-factor-password

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (Optional: Vercel Blob / Supabase)
# ------------------------------------------------------------------------------
# Injected automatically by Vercel when linking a Blob store
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# 7. ANALYTICS (Optional: self-hosted Umami)
# ------------------------------------------------------------------------------
# Substituted into client/index.html at build time. Leave both blank to disable
# analytics entirely — the build stays warning-free and injects no script.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

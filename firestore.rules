rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper: Check if user is authenticated and owns the data
    // OR if it's the legacy shared master_user
    function isOwner(userId) {
      return (request.auth != null && request.auth.uid == userId) || userId == 'master_user';
    }

    // Transactions Validation
    match /transactions/{txId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) 
                    && request.resource.data.amount is number 
                    && request.resource.data.amount > 0
                    && request.resource.data.date != null;
      allow update: if isOwner(resource.data.userId) 
                    && request.resource.data.userId == resource.data.userId;
    }

    // Accounts (Categories) Validation
    match /accounts/{accId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId)
                            && request.resource.data.name is string
                            && request.resource.data.type in ['income', 'expense'];
    }

    // Budgets, Goals, Recurring Validation
    match /budgets/{id} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId);
    }
    match /financial_goals/{id} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId);
    }
    match /recurring_templates/{id} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create, update: if isOwner(request.resource.data.userId);
    }
  }
}

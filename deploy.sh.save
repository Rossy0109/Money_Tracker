
#!/bin/bash
echo "🚀 Deploy শুরু হচ্ছে..."

# Build
echo "📦 Building..."
npm run build

# GitHub push
echo "📤 GitHub-এ push করছি..."
git add .
git commit -m "deploy: $(date '+%Y-%m-%d %H:%M')"
git push origin main

# Vercel deploy
echo "▲ Vercel-এ deploy করছি..."
vercel --prod

# Firebase deploy
echo "🔥 Firebase-এ deploy করছি..."
firebase deploy --only hosting

echo "✅ সব deploy সম্পন্ন!"
echo "🌐 Vercel: https://তোমার-app.vercel.app"
echo "🔥 Firebase: https://তোমার-project.web.app"

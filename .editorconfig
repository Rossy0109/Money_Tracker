# EditorConfig — keep formatting consistent across editors.
# Matches .prettierrc (2-space indent, LF, final newline); Prettier remains the
# formatter of record and runs via `pnpm format`.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
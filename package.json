{
  "name": "money-tracker",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/check-auth-mode.mjs development",
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "prebuild": "node scripts/check-auth-mode.mjs production",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:vercel": "node scripts/check-auth-mode.mjs production && vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/prepare-vercel-static.mjs && node scripts/build-vercel-api.mjs",
    "check:auth-mode": "node scripts/check-auth-mode.mjs",
    "check:vercel-entry": "node scripts/build-vercel-api.mjs && test -s dist/vercel-handler.js && grep -Eq 'export[[:space:]]*\\{|as default' dist/vercel-handler.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:isolated": "node scripts/run-isolated-e2e.mjs",
    "test:browser:e2e": "node scripts/run-browser-e2e.mjs",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:reconcile": "node scripts/reconcile-migrations.mjs",
    "db:rbac": "node scripts/apply-rbac-schema.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
